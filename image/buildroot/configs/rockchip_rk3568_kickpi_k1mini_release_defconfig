# ============================================================================
#  image/buildroot/configs/rockchip_rk3568_kickpi_k1mini_release_defconfig
#
#  KICKPI K1 Mini（RK3568）**发行镜像**的 buildroot defconfig（T15-2-2）
#
#  怎么用（在 SDK 根目录）—— 两条等价的路：
#      # 1) 直接让 buildroot 配置（输出目录跟 SDK 的约定一致）
#      cd buildroot
#      make O=output/rockchip_rk3568_kickpi_k1mini_release \
#           rockchip_rk3568_kickpi_k1mini_release_defconfig
#      # 2) 走 SDK 自己的 lunch（会顺带配内核/uboot/分区，整机构建用这条）
#      ./build.sh rk3566_rk3568:rockchip_rk3568_kickpi_k1mini_release_defconfig
#
#  这是**片段式**配置（与本 SDK 自带的 rockchip_rk3568_defconfig 同一套路）：
#  只 include 我们要的片段。相对下面这份"不做的事"，少 include 就是省事：
#      weston / X11 / chromium（没有桌面）、camera / can / pci、
#      SDK 的 benchmark + test 工具（那是开发板演示包，不是产品）
#
#  ⚠ `#include` 行**不能带尾注释**：SDK 给 buildroot 打的片段合并器是 sed 实现的，
#    它会把 `#include "x.config"   # 说明` 里的 "说明" 也当成路径去 sed 读 → 直接报错。
#    所以说明一律另起一行。
#
#  命名约定：chip defconfig 里的 `RK_BUILDROOT_BASE_CFG="rk3568_kickpi_k1mini_release"`
#  会派生出 `RK_BUILDROOT_CFG="rockchip_rk3568_kickpi_k1mini_release"`，
#  正好等于本文件名去掉 `_defconfig`（见 device/rockchip/common/configs/Config.in.buildroot）。
# ============================================================================

# 基座：eudev / ext4 / 基础工具（其中 eudev 会被下面的 products 片段换成 devtmpfs）
#include "base/base.config"
# RK3566/RK3568 + aarch64
#include "chips/rk3566_rk3568_aarch64.config"
# 思源黑体（中文界面必须）
#include "font/chinese.config"
# zh_CN.UTF-8 + unicode busybox
#include "locale/chinese.config"
# wpa_supplicant / hostapd + 基础网络
#include "wifibt/wireless.config"
# Rockchip MPP + DRM allocator + RGA
#include "multimedia/mpp.config"
# GStreamer 视频（mppvideodec 在这条链上）
#include "multimedia/gst/video.config"
# GStreamer 音频
#include "multimedia/gst/audio.config"
# rknpu2（librknnrt.so）
#include "ai/npu2.config"
# rockchip-mali（型号 G52 在本仓库的 products 片段里选）
#include "gpu/mali.config"
# 我们的：systemd + Qt5(EGLFS/虚拟键盘) + 运行时（本仓库维护）
#include "products/kickpi-k1mini-release.config"

# ---------------------------------------------------------------------------
#  T15-2-10b-2：python3 的两个 C 扩展模块（缺了 agent 直接起不来）
#  ---------------------------------------------------------------------------
#    · SSL → `_ssl` 与 `_hashlib`（python3.mk 用 --with-openssl 一次开两个）。
#      实测 chroot：`import agent.cli` 在
#          agent/net/sunshine_client.py:57 → import ssl → No module named '_ssl'
#      就断了，而 agent/core/__init__ 会连锁 import 到它 —— 板上表现就是
#      agent.service 一直崩溃重启。
#    · READLINE → 串口/ssh 里 CLI 的行编辑与历史（`/usr/bin/assistant` 给人用）。
#  写在 defconfig 末尾（所有 include 之后）是"顺序上必胜"的位置：值由**最后一个**
#  出现的赋值决定，这样即使以后有人在片段里写反了也压不住它。
#
#  ⚠ **踩过的坑，别误判**：把这两行只写进 products 片段时，改完配置去看 .config
#    仍然 `is not set`，很容易得出"片段合并器不认 python3 子选项"的错误结论。
#    真实原因是 **vendor 的 `./build.sh <defconfig>`（lunch）在已经配置过的树上
#    不会重新生成 buildroot 的 .config** —— 它只打印
#    "Running within sudo(root) environment! / Using last kernel version(6.1)" 就结束了。
#    实测对照：
#        ./build.sh rk3566_rk3568:<cfg>_defconfig        → .config 纹丝不动（时间戳没变）
#        cd buildroot && make O=output/<cfg> <cfg>_defconfig → 立刻 PYTHON3_SSL=y
#    整机构建（`./build.sh all` → `mk-buildroot.sh`）走的是后者那条路，所以
#    2-9 那次的 .config 是新的（当时我们还没加这两行，所以是 not set）。
# ---------------------------------------------------------------------------
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_READLINE=y
#: ★ 2026-10-07（T15-2-10c）：**zlib** —— 同一条船上的第三个模块。
#:   镜像里没有它 ⇒ `import zlib` 失败 ⇒ httpx2 的 `_decoders` 直接炸 ⇒ `import openai` 失败
#:   ⇒ agent 的 `llm.mode=edge` 全部降级到规则兜底（工具调用/搜索/入队全断 ✗）。
#:   板端实测那行：httpx2/_decoders.py: import zlib → ModuleNotFoundError: No module named 'zlib'
#:   C 库 `libz.so.1` 本来就在（很多包依赖 zlib ✓），缺的只是 python 侧的扩展模块 ⇒ 加这一行。
BR2_PACKAGE_PYTHON3_ZLIB=y
#: ★ 2026-10-07（T15-2-10d）：PYC_ONLY 的**教训**（下面这行是**无效的** ✗，留着当记录 ✓）。
#:   厂商默认开着"只留编译产物、删掉 .py 源码"，而 CPython 只能从"与源码同目录的**就地** .pyc"
#:   做无源码导入 ⇒ 这套机制很脆 ✗：实测（2026-10-07 22:0x）只要 .pyc 一丢，
#:   site-packages 里的 numpy、cv2 立刻退化成**空命名空间包** ⇒
#:   `import numpy` 报 `module 'numpy' has no attribute '__version__'` ✗（chroot 冒烟当场红 ✓）。
#:   ⚠ 试过在下面写一行"关掉它"，**没生效** ✗ —— 整机 .config 里仍是开的（被后面的片段/缺省压回来 ✓，
#:   同 §5.2 的"最后一个赋值说了算" ✓）。⇒ 结论改成纪律：
#:   **任何往 site-packages 里装东西的脚本，都不许删 `__pycache__` / `*.pyc`** ✗
#:   （两个 prepare-*.sh 里原先那两行 `find -delete` 已删 ✓）。⚠ 本注释里**不写符号全名**（规矩同上 ✓）。
# BR2_PACKAGE_PYTHON3_PYC_ONLY is not set

# ---------------------------------------------------------------------------
#  T15-2-11：wpa_supplicant 的 **D-Bus 控制接口**（不开就没有 WiFi）
#  ---------------------------------------------------------------------------
#  板端实测的现象：NetworkManager 把 wlan0 判成 `unavailable`，日志里是
#      device (wlan0): Couldn't initialize supplicant interface:
#                      Failed to D-Bus activate wpa_supplicant service
#      device (wlan0): supplicant interface keeps failing, giving up
#  原因是两条同时缺：
#    · 厂商的 `wireless.config` 片段开了 WPA_SUPPLICANT/AP/AUTOSCAN/EAP/CLI/...
#      **唯独没开 DBUS/DBUS_NEW** —— 于是 `/usr/sbin/wpa_supplicant -u` 直接把
#      用法打出来就退出（`-u` 不被识别），而我们那份
#      `wpa_supplicant.service`（Type=dbus / BusName=fi.w1.wpa_supplicant1）
#      因此起不来。
#    · `/usr/share/dbus-1/system-services/` 里也没有
#      `fi.w1.wpa_supplicant1.service` 这个激活文件（同样由 DBUS 选项带来）。
#  NM 只能通过 **新** D-Bus API 驱动 wpa_supplicant（`fi.w1.wpa_supplicant1`），
#  所以这个开关是必须的。
#  板上验证：手工 `wpa_supplicant -B -i wlan0 -c ...` + `udhcpc` 能拿到
#  192.168.137.30（关联状态机走完 COMPLETED）—— 也就是说 WiFi 硬件/驱动没问题，
#  缺的只是这条 D-Bus 通路。
#
#  ⚠ **踩过的坑**：别顺手再补一行"NEW 版"的那个开关（`..._DBUS_NEW`）。
#     在 buildroot 2024.02 里它已经是 **legacy 符号**（2019.08 把 new/old 两套合并成
#     一个 DBUS 开关），写了会去 select "legacy" 那个总开关，于是整机构建直接死在：
#         Makefile.legacy:9: *** "You have legacy configuration in your .config!"
#         ...br-rockchip_...log: Buildroot config changed! You might need to clean it
#     现在"新 API"就是唯一实现，单写这个 DBUS 开关即可（dbus 激活文件
#     `fi.w1.wpa_supplicant1.service` 就是由它带来的）。
#
#  ⚠ 注释里**不许出现配置记号**（本文件被 SDK 的 sed 片段合并器读；那条守卫测试
#     TestNoSymbolNamesInComments 就是拦这个的）——所以上面只写"DBUS 开关"这种说法。
#
#  写在 defconfig 末尾（所有 include 之后）：顺序上必胜，理由同上面 PYTHON3 那段。
# ---------------------------------------------------------------------------
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# ---------------------------------------------------------------------------
#  T15-2-11：root 密码 + sshd 允许密码/密钥登录（现场开发必须）
#  ---------------------------------------------------------------------------
#  为什么要设：板子起来之后唯一的交互通道就是网络/串口，而"改完要断电"这件事
#  只能靠 `poweroff`（正常关机）—— 拔插头会让 ext4 每次开机都走 fsck，也容易
#  留下脏状态。而首刷之后 root 是**空密码**，sshd 又不允许空密码登录
#  （`PermitEmptyPasswords no`），于是只能靠密钥；现场换台电脑/换工具就进不去。
#  所以：烘一个已知密码（`assistant`），并让 sshd 明确允许 root 用密码登录。
#  ⚠ 这是**开发期的便利**，不是发行形态：T15-12 收发行镜像时要做一次安全清理
#    （改密码 / 只留密钥 / 关掉密码认证），那里会把这条去掉或改成 dev 专属。
#  ⚠ 密钥登录同样可用：把公钥放 `image/local/authorized_keys`（不进仓库），
#    post-build 会装成 /root/.ssh/authorized_keys（0600）。
# ---------------------------------------------------------------------------
BR2_TARGET_GENERIC_ROOT_PASSWD="assistant"

# ---------------------------------------------------------------------------
#  T15-14：OTA 执行者 —— 瑞芯微官方的 Linux 升级工具
# ---------------------------------------------------------------------------
#  为什么：A/B 无线 OTA 的**板端那一半**就是它。出包在宿主侧（`./build.sh
#  ota-updateimg` -> `device/rockchip/common/scripts/mk-updateimg.sh`），板端用
#  `/usr/bin/rkupdate` 消费那个包。
#  ⚠ 这个包**默认是关的**，所以在此之前板上 `command -v rkupdate` 是 none
#    （2026-10-04 实测）。来源：`external/rkupdate` +
#    `buildroot/package/rockchip/rkupdate/rkupdate.mk`（那个配方把它装到
#    `$(TARGET_DIR)/usr/bin/rkupdate`，0755）。
#  产物判据：镜像里 `/usr/bin/rkupdate` 在位；板上 `rkupdate --help` 能跑。
# ---------------------------------------------------------------------------
BR2_PACKAGE_RKUPDATE=y


# ---------------------------------------------------------------------------
#  T15-14：OTA 包只写"非当前槽"的两个分区（去掉 userdata/parameter/uboot/misc…）
#  ---------------------------------------------------------------------------
#  为什么：SDK 默认的 ab-ota 清单里含 userdata（会把 /data 上的模型与配置写掉 ✗），
#  还含 parameter/bootloader/uboot/oem。无线 OTA 只要 boot_a + system_a；
#  "切到新槽"那一步由我们自己的包装写 misc 的 BCB（可测、可回退）。
#  机制：mk-updateimg.sh 里"清单文件存在就直接 ln 成 package-file，否则自动生成"。
# ---------------------------------------------------------------------------
RK_OTA_PACKAGE_FILE_CUSTOM=y
RK_OTA_PACKAGE_FILE="ota-assistant-ab.txt"
