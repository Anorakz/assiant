# ============================================================================
#  image/buildroot/configs/rockchip_rk3568_kickpi_k1mini_release_defconfig
#
#  KICKPI K1 Mini（RK3568）**发行镜像**的 buildroot defconfig（T15-2-2）
#
#  怎么用（在 SDK 根目录）—— 两条等价的路：
#      # 1) 直接让 buildroot 配置（输出目录跟 SDK 的约定一致）
#      cd buildroot
#      make O=output/rockchip_rk3568_kickpi_k1mini_release \
#           rockchip_rk3568_kickpi_k1mini_release_defconfig
#      # 2) 走 SDK 自己的 lunch（会顺带配内核/uboot/分区，整机构建用这条）
#      ./build.sh rk3566_rk3568:rockchip_rk3568_kickpi_k1mini_release_defconfig
#
#  这是**片段式**配置（与本 SDK 自带的 rockchip_rk3568_defconfig 同一套路）：
#  只 include 我们要的片段。相对下面这份"不做的事"，少 include 就是省事：
#      weston / X11 / chromium（没有桌面）、camera / can / pci、
#      SDK 的 benchmark + test 工具（那是开发板演示包，不是产品）
#
#  ⚠ `#include` 行**不能带尾注释**：SDK 给 buildroot 打的片段合并器是 sed 实现的，
#    它会把 `#include "x.config"   # 说明` 里的 "说明" 也当成路径去 sed 读 → 直接报错。
#    所以说明一律另起一行。
#
#  命名约定：chip defconfig 里的 `RK_BUILDROOT_BASE_CFG="rk3568_kickpi_k1mini_release"`
#  会派生出 `RK_BUILDROOT_CFG="rockchip_rk3568_kickpi_k1mini_release"`，
#  正好等于本文件名去掉 `_defconfig`（见 device/rockchip/common/configs/Config.in.buildroot）。
# ============================================================================

# 基座：eudev / ext4 / 基础工具（其中 eudev 会被下面的 products 片段换成 devtmpfs）
#include "base/base.config"
# RK3566/RK3568 + aarch64
#include "chips/rk3566_rk3568_aarch64.config"
# 思源黑体（中文界面必须）
#include "font/chinese.config"
# zh_CN.UTF-8 + unicode busybox
#include "locale/chinese.config"
# wpa_supplicant / hostapd + 基础网络
#include "wifibt/wireless.config"
# Rockchip MPP + DRM allocator + RGA
#include "multimedia/mpp.config"
# GStreamer 视频（mppvideodec 在这条链上）
#include "multimedia/gst/video.config"
# GStreamer 音频
#include "multimedia/gst/audio.config"
# rknpu2（librknnrt.so）
#include "ai/npu2.config"
# rockchip-mali（型号 G52 在本仓库的 products 片段里选）
#include "gpu/mali.config"
# 我们的：systemd + Qt5(EGLFS/虚拟键盘) + 运行时（本仓库维护）
#include "products/kickpi-k1mini-release.config"

# ---------------------------------------------------------------------------
#  T15-2-10b-2：python3 的两个 C 扩展模块（缺了 agent 直接起不来）
#  ---------------------------------------------------------------------------
#    · SSL → `_ssl` 与 `_hashlib`（python3.mk 用 --with-openssl 一次开两个）。
#      实测 chroot：`import agent.cli` 在
#          agent/net/sunshine_client.py:57 → import ssl → No module named '_ssl'
#      就断了，而 agent/core/__init__ 会连锁 import 到它 —— 板上表现就是
#      agent.service 一直崩溃重启。
#    · READLINE → 串口/ssh 里 CLI 的行编辑与历史（`/usr/bin/assistant` 给人用）。
#  写在 defconfig 末尾（所有 include 之后）是"顺序上必胜"的位置：值由**最后一个**
#  出现的赋值决定，这样即使以后有人在片段里写反了也压不住它。
#
#  ⚠ **踩过的坑，别误判**：把这两行只写进 products 片段时，改完配置去看 .config
#    仍然 `is not set`，很容易得出"片段合并器不认 python3 子选项"的错误结论。
#    真实原因是 **vendor 的 `./build.sh <defconfig>`（lunch）在已经配置过的树上
#    不会重新生成 buildroot 的 .config** —— 它只打印
#    "Running within sudo(root) environment! / Using last kernel version(6.1)" 就结束了。
#    实测对照：
#        ./build.sh rk3566_rk3568:<cfg>_defconfig        → .config 纹丝不动（时间戳没变）
#        cd buildroot && make O=output/<cfg> <cfg>_defconfig → 立刻 PYTHON3_SSL=y
#    整机构建（`./build.sh all` → `mk-buildroot.sh`）走的是后者那条路，所以
#    2-9 那次的 .config 是新的（当时我们还没加这两行，所以是 not set）。
# ---------------------------------------------------------------------------
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_READLINE=y
