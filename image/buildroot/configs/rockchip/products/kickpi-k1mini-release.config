# ============================================================================
#  image/buildroot/configs/rockchip/products/kickpi-k1mini-release.config
#
#  KICKPI K1 Mini（RK3568）**发行镜像**的 buildroot 片段（T15-2-2）
#
#  它被 buildroot/configs/rockchip_rk3568_kickpi_k1mini_release_defconfig 用
#  `#include` 引进来（与 SDK 自带的 rockchip_rk3568_defconfig 同一套路）。
#  片段顺序很重要：**基座片段在前、本文件在后**，所以这里可以覆盖基座的选择。
#
#  目标（用户 2026-09-28 定的路线 C / D1）：没有 X、没有桌面；系统起来之后
#  **只有**我们的 Agent + GUI（外加 NetworkManager 与串口 CLI）。
#  配置取舍与理由见 docs/image.md。
#
#  ⚠ 写这个文件的四条纪律（都是踩出来的，别改回去）
#    1. 不要写**尾注释**：SDK 给 buildroot 打的片段合并器是 sed 实现的，
#       它会把行尾注释原样带进"值"里（实测 CA_CERTIFICATES 的"新值"就带上了注释文本）。
#    2. include 行更不能带尾注释：它会把注释当路径去读，直接
#       "The merge file 'configs/rockchip/#' does not exist. Exit."
#    3. **注释里不要出现符号全名**（那种 BR2_ 开头、带等号的写法）：合并器的 sed
#       会把它当成一条配置去解析 —— 实测它把一句注释当成了 CA_CERTIFICATES 的新值。
#       所以下面提到符号时一律省略 BR2_ 前缀、也不写等号。
#    4. 这个文件里的每个符号都必须真的存在于本树（写错的会被 kconfig 静默丢掉，
#       于是"配置看起来写了、其实没生效" —— 串口那条就吃过一次）。
# ============================================================================

# ---------------------------------------------------------------------------
#  init：systemd
#  为什么必须用它：我们整套运维（agent.service / agent-gui-nox.service /
#  assistant.target）与 T14 的验收脚本都是 systemd 口径；busybox init 会把它们全废掉。
# ---------------------------------------------------------------------------
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_SYSTEM_DEFAULT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# /dev 管理方式**不用管**：本树里那个 choice 写的是
#     prompt "/dev management" if !BR2_INIT_SYSTEMD
# 也就是说选了 systemd 它就隐藏 —— base 片段里那句"用 eudev"因此是**死条款**
# （kconfig 直接丢掉）。实测生成的 .config 里既没有 eudev、也没有任何
# 设备管理方式的行，只有 HAS_UDEV=y（由 systemd 提供）。所以这里故意不写。

# ---------------------------------------------------------------------------
#  本地化 / 标识
# ---------------------------------------------------------------------------
BR2_TARGET_LOCALTIME="Asia/Shanghai"
BR2_TARGET_GENERIC_HOSTNAME="assistant"
BR2_TARGET_GENERIC_ISSUE="assistant (RK3568 K1 Mini)"
BR2_TARGET_GENERIC_ROOT_PASSWD=""

# 串口控制台**保留**：D6 要求"CLI 也能唤醒"，串口是最稳的那条 CLI 通路。
# ⚠ 本树里必须先开 SERIAL_SHELL_GETTY（它会 select GENERIC_GETTY）；
#   只写 GENERIC_GETTY 是无效的 —— 实测第一次跑就是这条静默没生效。
BR2_TARGET_SERIAL_SHELL_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"

# ---------------------------------------------------------------------------
#  Qt5：EGLFS + Widgets + Qt 虚拟键盘
#  SDK 自带的 gui 片段只有 lvgl/weston/x11 —— **没有 Qt5 片段**，所以这一组是手写的。
# ---------------------------------------------------------------------------
BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE=y
BR2_PACKAGE_QT5BASE_GUI=y
BR2_PACKAGE_QT5BASE_WIDGETS=y
BR2_PACKAGE_QT5BASE_NETWORK=y
BR2_PACKAGE_QT5BASE_XML=y
BR2_PACKAGE_QT5BASE_EGLFS=y
BR2_PACKAGE_QT5BASE_OPENGL_ES2=y
BR2_PACKAGE_QT5BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT5BASE_FONTCONFIG=y
BR2_PACKAGE_QT5BASE_PNG=y
BR2_PACKAGE_QT5BASE_JPEG=y
BR2_PACKAGE_QT5BASE_GIF=y
BR2_PACKAGE_QT5BASE_DBUS=y
BR2_PACKAGE_QT5BASE_SYSLOG=y
BR2_PACKAGE_QT5MULTIMEDIA=y
BR2_PACKAGE_QT5DECLARATIVE=y
BR2_PACKAGE_QT5DECLARATIVE_QUICK=y
BR2_PACKAGE_QT5QUICKCONTROLS2=y
BR2_PACKAGE_QT5SVG=y
BR2_PACKAGE_QT5VIRTUALKEYBOARD=y
BR2_PACKAGE_QT5VIRTUALKEYBOARD_LANGUAGE_LAYOUTS="en_US zh_CN"

# 上面这组的关键点：
#   · Widgets  —— 我们的 GUI 是 Qt Widgets，不是 QML 应用
#   · Network  —— LocalClient 走 QLocalSocket
#   · EGLFS    —— 无 X 的平台；它会 select OpenGL，GLES2 是 Mali 上的正确后端。
#                 eglfs 的 device integration 由 qt5base.mk 按可用包选：
#                 我们给了 libgbm/libegl（下面 mali 那组）→ 走 eglfs_kms，
#                 与板端实测一致（docs/gui.md §1.1）
#   · Declarative(+Quick) / QuickControls2 —— 虚拟键盘面板是 QML 写的，
#                 少了就是"白板"（T15-1 1b 卡点①：四个 QML 运行时模块）
#   · VirtualKeyboard —— 软键盘本体；布局 en_US + zh_CN（zh_CN 是拼音布局）
#   · SVG      —— GUI 的图标是 svg（打进 qrc）
#   · Multimedia —— GUI 的 QMediaPlayer（GStreamer 后端 + mppvideodec 硬解）

# ---------------------------------------------------------------------------
#  GPU / 媒体 / NPU
#  gpu/mali.config 已经给了 rockchip-mali 这个包，这里只选**型号**：
#  K1 Mini 是 **Bifrost G52**（板端实测装的 libmali-bifrost-g52-g2p0-x11 可用，
#  且它导出 35 个 gbm_* 符号 → EGLFS/GBM 没问题）。
#  ⚠ 已知缺口：SDK 的 external/libmali 里**只有 valhall-g610**（RK3588），
#    没有 G52 的 .so → T15-2-5 用厂商 deb 里那份
#    libmali-bifrost-g52-g24p0-x11-wayland-gbm_1.9-1_arm64.deb 补上。
#    （本片段只保证"配置对"；能不能编出来取决于那一步。）
# ---------------------------------------------------------------------------
BR2_PACKAGE_ROCKCHIP_MALI_BIFROST_G52=y
BR2_PACKAGE_ROCKCHIP_MALI_HAS_GBM=y
BR2_PACKAGE_ROCKCHIP_MALI_HAS_EGL=y
BR2_PACKAGE_ROCKCHIP_MALI_HAS_GLES=y

# ---------------------------------------------------------------------------
#  输入：EGLFS 下 Qt 靠 libinput 认触摸/键鼠（T15-1 1b 实测日志里就是 libinput）。
#  D6 的"触摸唤醒"也要这条路活着。
# ---------------------------------------------------------------------------
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_MTDEV=y

# ---------------------------------------------------------------------------
#  网络：NetworkManager（GUI 第 4 张卡片与 T15-9 都靠 nmcli）。
#  wpa_supplicant/hostapd 由基座片段 wifibt/wireless.config 给。
#  network.config 默认塞 dropbear，我们换 openssh（与现在板子一致，
#  `ssh rk3568` 那套密钥/运维都用得上；dev 镜像才会真正开放登录）。
#  CA 证书必须有：HTTPS（B 站 API / 云端 LLM）没有它全废。
# ---------------------------------------------------------------------------
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_TZDATA=y
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_DROPBEAR is not set

# ---------------------------------------------------------------------------
#  我们的运行时（Agent 是 Python；GUI 的日程区用 yaml-cpp 只读 config.yaml）
#  板端实测依赖：python3 + PyYAML + numpy + opencv(cv2)
#  （agent/ 里 yaml/cv2/numpy 都是懒加载；仓库目前**没有**依赖声明文件 → T15-2-7 补）
# ---------------------------------------------------------------------------
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PYYAML=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_OPENCV4=y
BR2_PACKAGE_OPENCV4_LIB_PYTHON=y
BR2_PACKAGE_YAML_CPP=y

# ---------------------------------------------------------------------------
#  T15-2-7 才会打开的东西（这里先留位，避免现在就把"还不存在的 overlay"写进构建）：
#    · rootfs overlay 指向 board/rockchip/kickpi/k1mini（我们的 unit / 脚本 / 配置）
#    · llama-server 与模型（4.9 GB）的落点
# ---------------------------------------------------------------------------
