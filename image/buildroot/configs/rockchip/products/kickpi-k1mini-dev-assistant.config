# ============================================================================
#  image/buildroot/configs/rockchip/products/kickpi-k1mini-dev-assistant.config
#
#  K1 Mini **开发镜像**（T15-2-12）在发行镜像之上**多出来的东西**。
#
#  谁引用它：`configs/rockchip_rk3568_kickpi_k1mini_dev_defconfig`
#            （用一行裸 #include 引进来，这里不许有尾注释 —— 见下面纪律）
#  落到哪：  `buildroot/configs/rockchip/products/kickpi-k1mini-dev-assistant.config`
#            （SDK 里厂商同类片段就放在这个目录，我们**新增**同名风格的文件，
#              不覆盖厂商任何东西）
#
#  为什么开发镜像要单独一套（而不是往发行镜像里塞）
#  ---------------------------------------------------------------------------
#  发行镜像要小、要少面：多一个 gcc 就多几百 MB，多一个 gdb/strace 就多一份
#  被滥用的可能。两者共用**同一套配方**，差别只有这一个片段 —— 这样"开发镜像
#  与发行镜像行为一致"这件事是**结构上**保证的，不靠人去同步两份配置。
#
#  纪律（踩过的坑）
#  ---------------------------------------------------------------------------
#  1) **注释里不许出现构造记号的字面量**：SDK 的片段合并是 sed 实现的，注释里
#     写一个 `BR2_` 开头的记号会被当成配置行去解析（T15-2-2 那次 u-boot 片段
#     就是这么炸的）。下面每条都写成中文说明。
#  2) **不许有尾注释**：`#include "x"  # 说明` 里的说明会被当路径去读。
#  3) 只**加**不改：这个片段不推翻发行镜像的任何选择（要改就在 release 那份改，
#     两边一起受益）。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 板上自带编译链
#  ---------------------------------------------------------------------------
#  我们用的是 Buildroot 自建工具链（不是外部 toolchain），所以"板上 gcc"这个
#  选项才可选。它会连带把 binutils、gmp、mpfr、mpc 一起装上。
#  ⚠ 这是**开发镜像专属**：发行镜像绝不该带编译器。
BR2_PACKAGE_GCC_TARGET=y

#  binutils 的**板上二进制**（as/ld/objdump/... ）；gcc 选项已隐式打开它，
#  这里显式写出来是为了"清单可读、不依赖隐含继承"。
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y

#  构建工具：make / cmake / pkgconf。
#  ⚠ **cmake 这个包在本套 buildroot 里是个"隐藏符号"**：那个直呼其名的记号没有
#    提示、defconfig 里写了也会被 kconfig **静默丢掉**（实测就是这样没生效，
#    而且 `make <defconfig>` 一句错都不报）。板上 cmake 本体只能由 **ctest** 那个
#    有提示的选项 select 出来，所以这里开 ctest（顺带带进 cmake 本体与它的依赖：
#    zlib/jsoncpp/libcurl/libarchive/expat/bzip2/xz/libuv/rhash）。前提（C++、
#    gcc≥4.9、NPTL、wchar、动态库、MMU）发行镜像里本来就满足，实测全部为 y。
#  ⚠ ninja **不在这份清单里**：这套 buildroot 里 ninja 只有 host 版（没有板上
#    包），所以板端 cmake 请用默认的 Unix Makefiles 生成器（`cmake ..` 即可）。
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_CMAKE_CTEST=y
BR2_PACKAGE_PKGCONF=y

# ---------------------------------------------------------------------------
# 2) 调试与排障
#  ---------------------------------------------------------------------------
#  gdb：板上调试器本体 + gdbserver（远端调试/脱靶调板上进程用得上）。
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_DEBUGGER=y
BR2_PACKAGE_GDB_SERVER=y

#  系统调用跟踪：定位"卡在哪一步"最省事的工具。
BR2_PACKAGE_STRACE=y

#  procps：**这条是补课**。板端实测（T15-2-11）发行镜像里没有 pgrep/pkill，
#  我们的脚本按常规写法用了 pgrep，结果"判进程在不在"整段逻辑失效 ——
#  开发镜像必须带它（top/ps/free 也一并有了）。
BR2_PACKAGE_PROCPS_NG=y

#  编辑器：只要 vim（用户 2026-10-02 明确不要 nano）。
BR2_PACKAGE_VIM=y

# ---------------------------------------------------------------------------
# 3) 网络工具（T15-9 以太网/WiFi 分别测试与自动切换会用）
# ---------------------------------------------------------------------------
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_IPERF3=y

# ---------------------------------------------------------------------------
# 4) 版本控制与测试
#  ---------------------------------------------------------------------------
#  git：板上直接看 diff / 拉小改动（大仓库还是走 PC 侧）。
BR2_PACKAGE_GIT=y

#  pytest：出口判据"能在板上跑 pytest 与验收脚本"靠它。
BR2_PACKAGE_PYTHON_PYTEST=y

#  python3 的 zlib 模块：发行镜像里**没有**（实测 ab-mark 那类脚本会
#  `ModuleNotFoundError: No module named 'zlib'`）。开发镜像补上，
#  这样仓库里的测试脚本在板上跑不会因为缺模块假失败。
BR2_PACKAGE_PYTHON3_ZLIB=y
